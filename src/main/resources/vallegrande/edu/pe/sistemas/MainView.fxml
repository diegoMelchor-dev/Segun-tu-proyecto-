<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vallegrande.edu.pe.sistemas.view.MainView"
            prefWidth="980" prefHeight="620">

    <!-- 1. MENÚ LATERAL AZUL -->
    <left>
        <VBox spacing="15" prefWidth="210" style="-fx-background-color: #2563EB; -fx-padding: 25 15;">
            <Label text="MI SISTEMA" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
            <Region prefHeight="10" />
            <Button fx:id="btnInicio" text="Inicio" maxWidth="Infinity" prefHeight="38"
                    style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button fx:id="btnUsuarios" text="Contactos" maxWidth="Infinity" prefHeight="38"
                    style="-fx-background-color: white; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button fx:id="btnPedidos" text="Pedidos" maxWidth="Infinity" prefHeight="38"
                    style="-fx-background-color: white; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
        </VBox>
    </left>

    <!-- 2. PANEL CENTRAL DE CONTENIDO -->
    <center>
        <StackPane style="-fx-background-color: #F8FAFC; -fx-padding: 25;">

            <!-- Vista de Inicio (oculta por defecto) -->
            <VBox fx:id="panelInicio" spacing="20" alignment="CENTER" visible="false" managed="false">
                <Label text="Bienvenido al Sistema" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            </VBox>

            <!-- Vista de Contactos -->
            <VBox fx:id="panelUsuarios" spacing="12" visible="true" managed="true">

                <Label text="CONTACTOS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

                <VBox spacing="8">
                    <TextField fx:id="txtNombre" promptText="Nombre completo" prefHeight="34"
                               style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                    <TextField fx:id="txtCorreo" promptText="Correo electrónico" prefHeight="34"
                               style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                    <TextField fx:id="txtTelefono" promptText="Teléfono" prefHeight="34"
                               style="-fx-background-radius: 4; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
                    <ComboBox fx:id="cmbMotivo" promptText="Motivo de contacto" maxWidth="Infinity" prefHeight="34" />
                    <TextArea fx:id="txtMensaje" promptText="Escribe tu mensaje... (máx. 500)"
                              prefRowCount="3" wrapText="true" />

                    <HBox spacing="10" style="-fx-padding: 5 0 0 0;">
                        <Button fx:id="btnRegistrar" text="Registrar" prefHeight="34" prefWidth="100"
                                style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button fx:id="btnActualizar" text="Actualizar" prefHeight="34" prefWidth="100"
                                style="-fx-background-color: #EAB308; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button fx:id="btnEliminar" text="Eliminar" prefHeight="34" prefWidth="100"
                                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </VBox>

            <!-- Vista de Pedidos (MainView le agrega el PedidosView en código) -->
            <VBox fx:id="panelPedidos" spacing="15" visible="false" managed="false" />

        </StackPane>
    </center>
</BorderPane>