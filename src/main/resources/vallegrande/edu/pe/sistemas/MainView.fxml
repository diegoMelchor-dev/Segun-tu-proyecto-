<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vallegrande.edu.pe.sistemas.view.MainView"
            prefWidth="800" prefHeight="600">
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button fx:id="btnInicio" text="Inicio"/>
            <Button fx:id="btnUsuarios" text="Usuarios"/>
        </HBox>
    </top>
    <center>
        <StackPane>
            <!-- Pantalla de inicio -->
            <VBox fx:id="panelInicio" alignment="CENTER">
                <Label text="Bienvenido"/>
            </VBox>

            <!-- Pantalla de usuarios: formulario + tabla -->
            <VBox fx:id="panelUsuarios" spacing="10" visible="false" managed="false"
                  style="-fx-padding: 20;">
                <Label text="USUARIOS" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtNombre" promptText="Nombre"/>
                <TextField fx:id="txtApellido" promptText="Apellido"/>
                <TextField fx:id="txtCorreo" promptText="Correo"/>
                <TextField fx:id="txtEstado" promptText="Estado"/>
                <Button fx:id="btnRegistrar" text="Registrar"/>
                <Button fx:id="btnActualizar" text="Actualizar"/>
                <Button fx:id="btnEliminar" text="Eliminar"/>
                <TableView fx:id="tablaUsuarios" prefHeight="300"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>